# Torch — environment variables. Copy to .env.local and fill in.
#   cp .env.example .env.local
#
# Minimum to run: DATABASE_URL + the two Clerk keys + OPENAI_API_KEY.

# ── Clerk auth (required) ─────────────────────────────────────────────────────
# Dashboard → API keys. `clerk env pull` can write these for you.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Database (required) ───────────────────────────────────────────────────────
# Postgres with the pgvector extension. Run `pnpm db:migrate` after setting.
DATABASE_URL=postgres://user:password@host:5432/torch

# ── AI models (required: OPENAI_API_KEY for embeddings) ───────────────────────
AI_PROVIDER=openrouter                 # openrouter | openai  (chat provider)
AI_CHAT_MODEL=openai/gpt-4o-mini       # any model id the provider exposes
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=sk-xxx                  # embeddings (+ chat if AI_PROVIDER=openai)
OPENROUTER_API_KEY=                    # required if AI_PROVIDER=openrouter

# ── Reranker (optional) ───────────────────────────────────────────────────────
AI_RERANK_STRATEGY=llm                 # llm | cohere | none | auto
COHERE_API_KEY=                        # only for cohere
AI_RERANK_MODEL=rerank-v3.5
AI_RERANK_LLM_MODEL=                   # defaults to AI_CHAT_MODEL

# ── Scripture (optional) ──────────────────────────────────────────────────────
# Public-domain Bibles need no key (pnpm bibles:public). api.bible is only for
# quote-only licensed translations (NIV/NKJV).
API_BIBLE_KEY=
API_BIBLE_IDS=                         # JSON, e.g. {"NIV":"<bibleId>"}

# ── Ops (optional) ────────────────────────────────────────────────────────────
LOG_LEVEL=info                         # debug | info | warn | error
RATE_LIMIT_CHAT_PER_MIN=20

# ── Containers / deploy (optional) ────────────────────────────────────────────
APP_ROLE=all                           # all | web | admin  (per-container surface)
RUN_MIGRATIONS=false                   # true on ONE container to migrate on boot
