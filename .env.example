# ──────────────────────────────────────────────────────────────────────────────
# Torch — environment template. Copy to `.env.local` and fill in.
#   cp .env.example .env.local
# Only DATABASE_URL, the Clerk keys, and ONE AI key are required for a working v1.
# ──────────────────────────────────────────────────────────────────────────────

# ── Auth (Clerk) ──────────────────────────────────────────────────────────────
# From the Clerk dashboard → API keys. REQUIRED.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Keep these as-is unless you change the routes.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Database (Railway Postgres + pgvector) ────────────────────────────────────
# REQUIRED. Any Postgres with the pgvector extension available.
# Then run: pnpm db:migrate  (enables pgvector + creates tables)
DATABASE_URL=postgres://user:password@host:5432/torch

# ── AI providers (config-only swaps — see lib/providers) ──────────────────────
# AI_PROVIDER selects the CHAT provider. Embeddings always use OpenAI.
#   openrouter → chat via OpenRouter (needs OPENROUTER_API_KEY) + OPENAI_API_KEY for embeddings
#   openai     → chat + embeddings both via OpenAI (needs only OPENAI_API_KEY)
AI_PROVIDER=openrouter
AI_CHAT_MODEL=openai/gpt-4o-mini          # any OpenRouter model id (e.g. anthropic/claude-3.5-sonnet, a MiniMax id)
AI_EMBEDDING_MODEL=text-embedding-3-small # keep in sync with AI_EMBEDDING_DIMENSIONS + the schema
AI_EMBEDDING_DIMENSIONS=1536

# Keys. You need OPENAI_API_KEY for embeddings regardless of provider.
OPENROUTER_API_KEY=                        # required if AI_PROVIDER=openrouter
OPENAI_API_KEY=sk-xxx                       # required (embeddings; also chat if AI_PROVIDER=openai)

# ── Reranker (optional — improves retrieval quality) ──────────────────────────
# Strategy: auto | cohere | llm | none
#   auto   → Cohere if COHERE_API_KEY is set, else LLM rerank via the chat provider
#   llm    → score candidates with a chat model (works on OpenRouter; NO extra key)
#   cohere → Cohere rerank API (needs COHERE_API_KEY)
#   none   → skip reranking (use raw vector-similarity order)
# NOTE: OpenRouter has no rerank endpoint — use "llm" (or "none") if you only have OpenRouter.
AI_RERANK_STRATEGY=auto
COHERE_API_KEY=                            # only for AI_RERANK_STRATEGY=cohere/auto
AI_RERANK_MODEL=rerank-v3.5                # Cohere model id
AI_RERANK_LLM_MODEL=                       # optional chat model for llm rerank (defaults to AI_CHAT_MODEL)

# ── Scripture ─────────────────────────────────────────────────────────────────
# Public-domain translations (KJV/ASV/YLT/BSB/Geneva) load with `pnpm bibles:public`
# and need no key. api.bible is only for quote-only licensed translations (NIV/NKJV).
API_BIBLE_KEY=                              # your api.bible key (https://docs.api.bible)
# Optional JSON map of translation code → api.bible Bible id, e.g.:
#   API_BIBLE_IDS={"NIV":"<bibleId>","NKJV":"<bibleId>"}
API_BIBLE_IDS=

# ── Ops ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=info                             # debug | info | warn | error
RATE_LIMIT_CHAT_PER_MIN=20
